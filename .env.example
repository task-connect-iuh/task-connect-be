# Sao chep file nay thanh .env truoc khi chay docker compose.
# .env khong duoc commit.

# MariaDB. Kien truc la 1 database duy nhat ("taskconnect") tren 1 instance, moi module
# so huu mot nhom bang rieng phan biet bang tien to ten bang (auth_, user_...) - xem
# .claude/rules/12-database.md. Database duoc tao tu dong boi bien MARIADB_DATABASE
# khai bao thang trong docker-compose.yml.
MARIADB_ROOT_PASSWORD=changeme_root
MARIADB_USER=taskconnect
MARIADB_PASSWORD=changeme_app
# Neu may ban co san MySQL/MariaDB cai truc tiep (XAMPP, WAMP, Windows Service...)
# dang chiem cong 3306, doi sang cong khac (vd 3307) de tranh xung dot voi container.
MARIADB_PORT=3306

# Spring Boot (app chay tren host, ket noi ra container qua port da publish o tren).
# File .env duoc doc tu dong luc khoi dong nho dependency me.paulschwarz:spring-dotenv
# (xem pom.xml), khong can export thu cong thanh bien moi truong.
# DB_PORT phai khop MARIADB_PORT o tren. DB_NAME la database duy nhat "taskconnect".
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskconnect
DB_USER=taskconnect
DB_PASSWORD=changeme_app

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=taskconnect
RABBITMQ_PASSWORD=changeme_mq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Email (Brevo SMTP relay). Lay tai app.brevo.com > SMTP & API > SMTP.
# MAIL_USERNAME la login SMTP cua Brevo (dang 8xxxxx@smtp-brevo.com), KHONG phai email
# dang nhap tai khoan Brevo. MAIL_PASSWORD la SMTP key, khong phai mat khau tai khoan.
# MAIL_FROM_ADDRESS phai la dia chi da xac minh trong Brevo (Senders & IP), neu khong
# relay se tu choi voi loi 550. Goi mien phi Brevo gioi han 300 email/ngay.
#
# De MAIL_ENABLED=false khi chua co key: app van chay binh thuong, email khong duoc
# gui that, luong nghiep vu (sinh ma, luu DB) van chay day du - chi khong co email nao
# ra ngoai.
MAIL_ENABLED=false
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@taskconnect.vn
MAIL_FROM_NAME=TaskConnect

# JWT. Doi JWT_SECRET truoc khi len production, toi thieu 32 ky tu.
JWT_SECRET=changeme_jwt_secret_min_32_characters
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=15
# Cookie refresh token chi gui qua HTTPS khi true. De false o dev vi app chay tren
# http://localhost khong co HTTPS - BAT BUOC doi thanh true khi len production.
JWT_REFRESH_COOKIE_SECURE=false

# Domain frontend duoc phep goi API kem cookie (CORS). Nhieu domain cach nhau bang dau
# phay - 5173 la task-connect-fe (Poster/Tasker), 5174 la task-connect-admin (Admin, repo
# rieng). Doi sang domain that khi len production, khong duoc de "*" vi API dung
# Access-Control-Allow-Credentials=true.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Khoa ma hoa AES-256 dung chung cho du lieu nhay cam (CCCD - Buoc 4, so chung chi va URL
# file chung chi - Buoc 6 trong docs/PROGRESS-USER-MODULE.md). Base64 cua dung 32 byte.
# Gia tri duoi day chi danh cho dev - BAT BUOC sinh khoa rieng khi len production
# (openssl rand -base64 32), vi khoa nay dang nam cong khai trong repo.
APP_CRYPTO_KEY=gvuR3TBLZYe2nwVikB8pQpal7zsbVP9y1EXDSrVhWCk=

# AWS S3 - luu anh dai dien (avatar), xem docs/adr/ADR-003-avatar-storage-s3-presigned-upload.md.
# Lay AWS_S3_ACCESS_KEY_ID/SECRET tu IAM user rieng cho backend (quyen han che, chi
# PutObject/GetObject/DeleteObject trong prefix avatars/* cua dung bucket nay - khong dung
# access key cua root account). Xem huong dan tao bucket/IAM trong PROGRESS-USER-MODULE.md.
AWS_S3_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# Seed tai khoan super-admin duy nhat, chay 1 lan qua V10__seed_admin_account.sql khi
# database con rong. ADMIN_SEED_EMAIL cung la bien AuthService dung de nhan dien super-admin
# luc chay (app.admin.super-admin-email) - doi ca 2 cho khop nhau neu doi sau nay.
# ADMIN_SEED_PASSWORD_HASH la HASH BCRYPT tinh san, KHONG phai mat khau thuan (migration
# nam trong git history vinh vien, khong duoc de lo mat khau that). Tu tinh hash:
#   - Java: new BCryptPasswordEncoder().encode("mat-khau-that-cua-ban")
#   - Hoac dung mot cong cu bcrypt online/CLI bat ky (cost factor 10, khop
#     BCryptPasswordEncoder() mac dinh cua Spring Security dang dung trong SecurityConfig).
# Xem docs/PROGRESS-ADMIN-MODULE.md de biet toan bo mo hinh phan quyen.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD_HASH=

# Dang nhap Google. Client ID cua OAuth 2.0 Client (loai Web application) tao trong Google
# Cloud Console > APIs & Services > Credentials. Authorized JavaScript origins phai khop
# http://localhost:5173 (task-connect-fe). Khong can Client Secret - BE chi verify ID token
# bang audience (chinh gia tri nay), khong trao doi authorization code.
# Phai trung VITE_GOOGLE_CLIENT_ID ben task-connect-fe/.env.
GOOGLE_CLIENT_ID=

# Module AI (Gemini embedding + Groq LLM) - dung cho tinh nang "Tasker goi y" (module
# matching). Ca hai key BAT BUOC set, khong co default - thieu se app khong khoi dong duoc
# (giong JWT_SECRET/DB_PASSWORD). Lay GEMINI_API_KEY tai aistudio.google.com/apikey, lay
# GROQ_API_KEY tai console.groq.com/keys - ca hai deu co goi mien phi du dung cho quy mo do an.
GEMINI_API_KEY=
GROQ_API_KEY=
# Ten model Groq dang goi (mac dinh openai/gpt-oss-120b - xem application.yml). Dong Llama
# thô (llama-3.x) da bi Groq go khoi API that, khong con dung duoc. Chi doi bien nay neu Groq
# lai doi/go model lan nua - KIEM TRA DANH SACH THAT bang chinh key cua ban truoc khi doi:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# khong dua vao docs cong khai console.groq.com/docs/models, co the chua cap nhat kip.
GROQ_MODEL=openai/gpt-oss-120b
# Nguong tu ngat noi bo, chua margin so voi free tier that cua provider - xem QuotaTrackerService.
AI_EMBEDDING_DAILY_QUOTA=1000
# gpt-oss-120b free tier: 1.000 request/ngay NHUNG chi 200.000 token/ngay - TPD moi la gioi
# han that su. ~1.500-2.500 token/lan goi (10 ho so Tasker + mo ta Task) => chi ~80-130 lan
# goi/ngay la an toan, khong phai 900. Xem application.yml de biet chi tiet.
AI_LLM_DAILY_QUOTA=80
# Nguong % duoi do FE gan nhan "Do khop thap" cho mot Tasker duoc goi y - khong an bot, chi
# gan nhan (quyet dinh da chot voi nguoi dung, xem PROGRESS-AI-MATCHING-MODULE.md).
MATCHING_LOW_CONFIDENCE_THRESHOLD=50

# Xac minh so dien thoai qua Firebase Phone Auth (dung tinh nang "Phone numbers for testing"
# cua Firebase de demo - khong gui SMS that, khong ton quota). Tao Firebase project, bat
# Authentication > Sign-in method > Phone, khai bao vai so test + ma co dinh tai do.
# FIREBASE_PROJECT_ID phai khop projectId trong FIREBASE_SERVICE_ACCOUNT_JSON_BASE64 va
# VITE_FIREBASE_PROJECT_ID ben task-connect-fe.
FIREBASE_PROJECT_ID=
# Noi dung file JSON service-account (Firebase Console > Project Settings > Service accounts
# > Generate new private key), encode base64 TREN MOT DONG (vd: base64 -w0 service-account.json).
# Day la SECRET rieng cua backend, KHONG duoc commit, KHONG duoc dua vao bat ky bien VITE_*.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
